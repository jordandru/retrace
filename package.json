{
  "name": "retrace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Retrace — provenance ledger for mixed human + AI work",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @retrace/core && npm run build -w @retrace/cli",
    "test": "npm test -w @retrace/core && npm test -w @retrace/cli",
    "mcp": "node packages/mcp-server/dist/index.js",
    "serve": "node packages/mcp-server/dist/serve.js",
    "check-deploy": "node scripts/check-deploy.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
