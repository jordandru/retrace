{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/schemas/settings.schema.json",
  "mcpServers": {
    "retrace": {
      "command": "bash",
      "args": [
        "-c",
        "set -a && . \"$HOME/.retrace/gemini.env\" && set +a && exec node packages/mcp-server/dist/index.js"
      ],
      "cwd": ".",
      "env": {
        "RETRACE_URL": "https://retrace-api.slcwitit.workers.dev",
        "RETRACE_PROJECT": "retrace",
        "RETRACE_ACTOR": "gemini",
        "RETRACE_ON_BEHALF_OF": "jordansboxing@gmail.com",
        "RETRACE_SYSTEM": "gemini-cli"
      },
      "timeout": 30000,
      "trust": false,
      "description": "Verifiable provenance for work performed in this repository"
    }
  },
  "model": {
    "name": "gemini-3.5-flash"
  }
}
