{
  "mcpServers": {
    "retrace": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "set -a && . \"$HOME/.retrace/cursor.env\" && set +a && exec node packages/mcp-server/dist/index.js"
      ],
      "envFile": "${userHome}/.retrace/cursor.env",
      "env": {
        "RETRACE_PROJECT": "retrace",
        "RETRACE_ACTOR": "cursor-agent",
        "RETRACE_ON_BEHALF_OF": "jordansboxing@gmail.com",
        "RETRACE_URL": "https://retrace-api.slcwitit.workers.dev"
      }
    }
  }
}
