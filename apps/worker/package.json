{
  "name": "@retrace/worker",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "node ./migrate.mjs",
    "test": "esbuild src/*.test.ts --bundle --platform=node --format=esm --external:miniflare --outdir=.test-dist --out-extension:.js=.mjs && node --test .test-dist/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@retrace-dev/cli": "*",
    "@retrace-dev/core": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "esbuild": "^0.28.1",
    "miniflare": "^5.20261006.0-alpha",
    "wrangler": "^4.148.0"
  }
}
